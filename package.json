{
  "name": "kubang-yt",
  "version": "0.1.1",
  "private": true,
  "description": "Kubang YT desktop and Android app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "android:sync": "npm run build && cap sync android",
    "pre-dist": "node scripts/generate-brand-assets.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "electron": "39.2.0",
    "electron-builder": "26.0.12",
    "vite": "7.2.2",
    "wait-on": "8.0.4",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/android": "^7.4.3",
    "sharp": "^0.34.5",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.bostrading.ytmanager",
    "productName": "Kubang YT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/brand/kubang-yt.ico"
    }
  }
}
