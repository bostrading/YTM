{
  "name": "yt-manager",
  "version": "0.1.0",
  "private": true,
  "description": "YT Manager desktop app with isolated YouTube browser profiles",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "electron": "39.2.0",
    "electron-builder": "26.0.12",
    "vite": "7.2.2",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.bostrading.ytmanager",
    "productName": "YT Manager",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis"] }
  }
}